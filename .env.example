# Copy this file to .env and uncomment only what you need.
# .env is gitignored — never commit real keys.
# If your agent CLI (claude / codex) is already logged in, you can leave all of
# this alone.

# ── Agent keys (only for the agent you run) ──────────────────────────────────
# CLAUDE_CODE_OAUTH_TOKEN=...            # claude-code: REQUIRED. Run `claude setup-token` once.
#                                        # (Each episode runs in its own config dir, so your
#                                        # interactive `claude` login is not visible to it.)
# ANTHROPIC_API_KEY=sk-ant-...           # claude-code, instead of the OAuth token
# OPENAI_API_KEY=sk-...                  # native models; codex-cli ONLY to run OpenAI-platform
#                                        # models your Codex plan login doesn't offer (a key
#                                        # beats the `codex login` session when both exist)
# CODEX_API_KEY=...                      # codex-cli, instead of OPENAI_API_KEY
# FIREWORKS_API_KEY=fw_...               # Fireworks-hosted models
# OLLAMA_API_BASE=http://localhost:11434 # only if Ollama is not on the default host

# ── Device tools ──────────────────────────────────────────────────────────────
# QGB_MCP_SERVER=http://127.0.0.1:51821  # same as --mcp-server; unset = bare agent
# QGB_DISALLOWED_TOOLS=                  # tools to withhold, comma-separated

# ── Held-out split (journey mode) ─────────────────────────────────────────────
# A journey board REQUIRES the held-out split (docs/heldout.md): without it `run` and
# `preflight` refuse, because a public-only board cannot tell "found the bug" from
# "the model was trained on the answer key". The harness reads THIS variable only —
# a `heldout/` directory beside the repo is not picked up on its own.
# `uv run python scripts/holdout.py sync` verifies the split and prints this line.
# QGB_HELDOUT_DIR=/abs/path/to/heldout    # same as `heldout_dir:` in bench.config.yaml
# QGB_ALLOW_NO_HELDOUT=1                  # opt out: a deliberately public-only board
#                                         # (same as --allow-no-heldout)

# ── APKs and paths (rarely needed) ────────────────────────────────────────────
# QGB_CACHE_DIR=~/.cache/qualgentbench   # where downloaded APKs are cached
# QUALGENTBENCH_APK_BIRDAY=/path/to.apk  # pin one app's APK (one var per app id)
# QGB_ADB_PATH=/path/to/adb              # if adb is not on your PATH
# JAVA_HOME=/path/to/jdk17               # only for building apps yourself
