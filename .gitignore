# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Benchmark runs (artifacts can be large). runs-flagproof/ holds the Phase-2
# bug-gate proof episodes — same class of artifact, same reason to ignore.
runs/
runs-old/

# APK/IPA artifacts — hosted on HuggingFace, never committed
*.apk
*.ipa
*.aab

# Local APK overrides for development (see apps/manifest.yaml source.type: local)
apps/local/

# Environment
.env
.env.local
bench.config.yaml

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Node sidecar deps (limrun ADB tunnel). The lockfile IS committed — it pins
# the tunnel's transitive tree, which a reproducible benchmark depends on.
node_modules/

# Any data/ dir is device-pulled state that must never land in the repo —
# except the benchmark specs, re-included explicitly.
data/
!src/qualgentbench/data/

# The held-out split (docs/heldout.md): two journey apps whose case, truth, spec and
# asset files live OUTSIDE the repository so a model trained on the public corpus
# cannot have seen them. `scripts/holdout.py move` puts them here by default; the
# directory is never committed, and no file in the repo may name which apps it holds.
heldout/

# Agent worktrees and local Claude Code state. Worktrees are full checkouts, so
# committing this would nest the repo inside itself.
.claude/
